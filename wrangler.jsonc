{
  // One Worker serves the site (static assets) and the nearby-pilgrims relay (/ws).
  // Files that match a static asset are answered by the assets layer without
  // running worker code; the relay, counter, health check and legacy entry use server/worker.js.
  "name": "huasi",
  "main": "server/worker.js",
  "compatibility_date": "2025-06-01",
  // Custom domains switch workers.dev off unless it is kept on explicitly; the
  // GitHub Pages copy of the site connects to the relay on the workers.dev host.
  "workers_dev": true,
  "routes": [
    { "pattern": "sansitemple.com", "custom_domain": true },
    { "pattern": "www.sansitemple.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/huashan-temple.html", "/huashan-temple", "/huashan-temple/"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Other-origin pages allowed to open /ws. Same-origin is always allowed.
    "ALLOWED_ORIGINS": "https://sansitemple.com,https://www.sansitemple.com,https://chaoyuzhang001.github.io"
  }
}
